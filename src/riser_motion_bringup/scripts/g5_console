#!/usr/bin/env python3
"""Laptop Qt operator console for the RISER Jazzy manager."""

import argparse
import math
import os
import shlex
import sys
import time
import xml.etree.ElementTree as ET
from typing import ClassVar

import rclpy
from ament_index_python.packages import get_package_share_path
from builtin_interfaces.msg import Time
from control_msgs.msg import DynamicJointState
from controller_manager_msgs.srv import ListControllers, ListHardwareInterfaces
from PySide6 import QtCore
from PySide6 import QtWidgets as W
from rcl_interfaces.srv import GetParameters
from rclpy.node import Node
from rclpy.parameter_client import AsyncParameterClient
from rclpy.qos import DurabilityPolicy, QoSProfile, qos_profile_sensor_data
from rosbag2_interfaces.srv import IsPaused
from std_msgs.msg import String

from riser_motion_bringup.srv import Jog


class Console(W.QWidget):
    cap_names = (
        "max_velocity_m_s",
        "max_duration_s",
        "ramp_s",
        "max_acceleration_m_s2",
        "max_travel_m",
    )
    labels: ClassVar[dict[str, str]] = {
        "position": "Carriage position (m)",
        "velocity": "Carriage velocity (m/s)",
        "torque_nm": "Drive torque (shaft N·m)",
        "torque_raw": "0x6077 (per mille)",
        "reverse_limit": "Negative limit",
        "forward_limit": "Positive limit",
        "brake_release_request": "Brake release request (host servo enable)",
        "brake_output_feedback": "Brake output feedback",
        "physical_brake": "Physical brake",
        "feedback_valid": "Feedback valid",
        "ready": "Axis health",
    }

    def __init__(self, host):
        super().__init__()
        self.setWindowTitle("RISER commissioning")
        self.resize(960, 780)
        self.host = host
        self.node = Node("g5_operator")
        self.executor = rclpy.executors.SingleThreadedExecutor()
        self.executor.add_node(self.node)
        self.angle_time = 0
        self.angles = {}
        self.last = 0
        self.samples = {}
        self.excluded = {}
        self.rings = {}
        self.jobs = set()
        self.clients = {}
        self.beats = {}
        self.pulses = {}
        self.cap_clients = {}
        self.cap_request = None
        self.caps = {}
        layout = W.QVBoxLayout(self)
        tabs = W.QTabWidget()
        layout.addWidget(tabs)
        self.output = W.QPlainTextEdit(readOnly=True)
        self.output.setMaximumBlockCount(500)
        layout.addWidget(self.output)
        motion, data, system = [W.QFormLayout() for _ in range(3)]
        for name, form in zip(["Motion", "Data", "System"], [motion, data, system]):
            page = W.QWidget()
            page.setLayout(form)
            tabs.addTab(page, name)
        self.axis = W.QComboBox()
        self.axis.addItem("bottom_motor")
        motion.addRow("Carriage", self.axis)
        self.readout = W.QPlainTextEdit(readOnly=True)
        motion.addRow(self.readout)
        self.speed = self.field(motion, "Velocity (m/s)", "0.01")
        self.duration = self.field(motion, "Duration (s)", "1.0")
        self.budget = W.QLabel()
        motion.addRow("Host jog bounds", self.budget)
        self.buttons(
            motion,
            {
                "Jog": lambda: self.jog(False),
                "Cancel": lambda: self.jog(True),
                "Clear selected G5 fault": self.clear_fault,
                "Ordered bottom shutdown": self.shutdown_drive,
            },
        )
        self.index = self.field(motion, "SDO index", "0x603f")
        self.sub = self.field(motion, "Subindex", "0")
        self.dtype = W.QComboBox()
        self.dtype.addItems(["uint16", "uint32", "int16", "int32", "uint8", "int8"])
        motion.addRow("Datatype", self.dtype)
        self.buttons(motion, {"Upload SDO": self.upload})
        self.buttons(
            motion,
            {
                f"Capture {kind}": lambda kind=kind: self.run(
                    [
                        "ros2",
                        "service",
                        "call",
                        f"/g5_calibration/{self.axis.currentText()}/capture_{kind}",
                        "std_srvs/srv/Trigger",
                        "{}",
                    ]
                )
                for kind in ("negative", "zero", "positive")
            },
        )
        self.record_state = W.QLabel()
        data.addRow("Recorder", self.record_state)
        self.recorder = self.node.create_client(IsPaused, "/rosbag2_recorder/is_paused")
        self.pause_future = None
        self.desc = self.field(data, "Trial description", "")
        self.topics = self.field(
            data, "Record / export topics", "/dynamic_joint_states"
        )
        self.trial = self.field(data, "Finalized trial name", "")
        self.buttons(
            data,
            {
                k.title(): lambda k=k: self.trial_action(k)
                for k in [
                    "start",
                    "pause",
                    "resume",
                    "stop",
                    "list",
                    "verify",
                    "export",
                ]
            },
        )
        self.buttons(
            data,
            {
                "Transfer command": self.transfer,
                "Live PlotJuggler": lambda: self.run(
                    [
                        "ros2",
                        "run",
                        "plotjuggler",
                        "plotjuggler",
                        "-l",
                        str(
                            get_package_share_path("riser_motion_bringup")
                            / "config/g5_plot.xml"
                        ),
                    ]
                ),
                "Open local bag in PlotJuggler": self.open_bag,
            },
        )
        self.graph = W.QPlainTextEdit(readOnly=True)
        system.addRow(self.graph)
        self.controller = self.field(system, "Controller", "motor_profile")
        self.buttons(
            system,
            {
                k.title(): lambda k=k: self.lifecycle(k)
                for k in ["load", "configure", "activate", "deactivate", "unload"]
            },
        )
        self.param_node = self.field(system, "Parameter node", "/motor_profile")
        self.param = self.field(system, "Parameter name", "max_velocity_m_s")
        self.value = self.field(system, "Typed YAML value", "")
        self.buttons(
            system,
            {
                k.title(): lambda k=k: self.parameter(k)
                for k in ["list", "describe", "get", "set"]
            },
        )
        self.package = self.field(system, "Controller package", "riser_motion_bringup")
        self.mask = self.field(system, "Enabled axes after restart", "bottom")
        self.buttons(
            system,
            {
                "Rebuild / restart inhibited": self.rebuild,
                "Inactivate mock hardware": self.inactivate_mock,
                "Apply inactive mask": lambda: self.maintenance(
                    "--mask", self.mask.text()
                ),
                "Stop released manager": lambda: self.maintenance("--stop"),
            },
        )
        self.node.create_subscription(
            DynamicJointState,
            "/g5_plot/dynamic_joint_states",
            self.feedback,
            qos_profile_sensor_data,
        )
        self.node.create_subscription(
            String,
            "/robot_description",
            self.description,
            QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL),
        )
        self.node.create_subscription(
            DynamicJointState,
            "/g5_calibration/state",
            self.calibration,
            qos_profile_sensor_data,
        )
        self.controllers = self.node.create_client(
            ListControllers, "/controller_manager/list_controllers"
        )
        self.interfaces = self.node.create_client(
            ListHardwareInterfaces, "/controller_manager/list_hardware_interfaces"
        )
        self.snapshot = {}
        self.pending = {}
        self.param_client = None
        self.param_key = ""
        self.param_future = None
        self.param_descriptor = None
        self.param_display = ""
        self.timer = QtCore.QTimer(self)
        self.timer.timeout.connect(self.tick)
        self.timer.start(20)
        self.refresh = QtCore.QTimer(self)
        self.refresh.timeout.connect(self.poll)
        self.refresh.start(1000)

    def field(self, form, name, value):
        item = W.QLineEdit(value)
        form.addRow(name, item)
        return item

    def buttons(self, form, actions):
        row = W.QHBoxLayout()
        for name, callback in actions.items():
            button = W.QPushButton(name)
            button.clicked.connect(lambda checked=False, fn=callback: self.invoke(fn))
            row.addWidget(button)
        form.addRow(row)

    def invoke(self, callback):
        try:
            callback()
        except (ValueError, KeyError, OSError) as exc:
            self.output.appendPlainText(str(exc))

    def description(self, msg):
        hw = ET.fromstring(msg.data).find("ros2_control/hardware")
        if hw is None:
            return
        self.hw = {p.get("name"): p.text for p in hw.findall("param")}
        self.real = hw.findtext("plugin") == "riser_hardware/BottomCsvSystem"
        self.rings = {
            k.removesuffix("_position"): int(v, 0)
            for k, v in self.hw.items()
            if k.endswith("_motor_position")
        }

    def calibration(self, msg):
        if "calibrated_angles" in msg.joint_names:
            v = msg.interface_values[msg.joint_names.index("calibrated_angles")]
            self.angles = dict(zip(v.interface_names, v.values))
            self.angle_time = time.monotonic()

    def feedback(self, msg):
        age = self.node.get_clock().now().nanoseconds * 1e-9 - (
            msg.header.stamp.sec + msg.header.stamp.nanosec * 1e-9
        )
        self.last = time.monotonic() - abs(age)
        self.samples = {
            name: dict(zip(v.interface_names, v.values))
            for name, v in zip(msg.joint_names, msg.interface_values)
        }
        self.excluded = {
            n.removesuffix("_excluded"): self.samples.pop(n).get("discovered", math.nan)
            for n in list(self.samples)
            if n.endswith("_excluded")
        }
        if set(self.samples) != {
            self.axis.itemText(i) for i in range(self.axis.count())
        }:
            self.axis.clear()
            self.axis.addItems(list(self.samples))

    def tick(self):
        for _ in range(5):
            self.executor.spin_once(timeout_sec=0)
        for axis, (stamp, until) in list(self.pulses.items()):
            if time.monotonic() > until or time.monotonic() - self.last > 0.3:
                del self.pulses[axis]
            else:
                self.beats[axis].publish(stamp)
        v = self.samples.get(self.axis.currentText(), {})
        stale = time.monotonic() - self.last > 0.3 or v.get("feedback_valid") != 1

        def show(k, x):
            if not math.isfinite(x) or (
                k in ("brake_output_feedback", "physical_brake") and x == -1
            ):
                return "Unknown"
            if k == "ready":
                return {
                    0: "Unavailable or faulted",
                    1: "Healthy, disabled",
                    2: "Healthy, operation enabled",
                }.get(x, "Unknown")
            if k == "host_fault":
                causes = (
                    "Clear",
                    "I/O, sync or command",
                    "Cycle interval",
                    "Feedback lost or acquisition timed out",
                    "Unexpected drive disable",
                    "Drive fault",
                    "Invalid feedback",
                    "Travel limit",
                    "Speed limit",
                    "Mode mismatch",
                )
                code = int(x)
                return (
                    f"{code}  {causes[code]}" if 0 <= code < len(causes) else str(code)
                )
            if k in {"digital_inputs", "statusword", "controlword", "fault_code"}:
                return hex(int(x))
            return f"{x:.6g}"

        readout = (
            ("Stale" if stale else "Live")
            + "   enabled: "
            + getattr(self, "hw", {}).get("enabled_axes", "?")
            + "   configured: "
            + getattr(self, "hw", {}).get("configured_axes", "?")
            + "\n"
            + "".join(
                f"{axis} excluded, discovered {show('discovered', value)}\n"
                for axis, value in self.excluded.items()
            )
            + "\n".join(
                f"{self.labels.get(k, k)}    {show(k, x)}" for k, x in v.items()
            )
            + "\n"
            + "\n".join(
                f"{k}    {show(k, self.angles.get(k, math.nan)) if time.monotonic() - self.angle_time < 0.3 and not stale else 'Unknown / Stale'}"
                for k in ("footplate_rad", "ml_rad", "backboard_rad")
            )
        )

        if readout != self.readout.toPlainText():
            scrollbar = self.readout.verticalScrollBar()
            scroll = scrollbar.value()
            self.readout.setPlainText(readout)
            scrollbar.setValue(scroll)

    def poll(self):
        nodes = self.node.get_node_names_and_namespaces()
        self.poll_parameter()
        self.poll_caps()
        if self.recorder.service_is_ready():
            if self.pause_future is None or self.pause_future.done():
                if self.pause_future and self.pause_future.result():
                    self.record_state.setText(
                        "Paused" if self.pause_future.result().paused else "Recording"
                    )
                self.pause_future = self.recorder.call_async(IsPaused.Request())
        else:
            self.record_state.setText("Recorder unavailable")
            self.pause_future = None
        for key, client, req in [
            ("controllers", self.controllers, ListControllers.Request()),
            ("interfaces", self.interfaces, ListHardwareInterfaces.Request()),
        ]:
            if not client.service_is_ready():
                self.snapshot[key] = "Unavailable"
                if key in self.pending:
                    self.pending.pop(key).cancel()
                continue
            future = self.pending.get(key)
            if future and not future.done():
                continue
            if future and future.result():
                res = future.result()
                self.snapshot[key] = (
                    "\n".join(f"{c.name}  {c.state}" for c in res.controller)
                    if key == "controllers"
                    else "\n".join(
                        f"{i.name}  available={i.is_available} claimed={i.is_claimed}"
                        for i in [*res.command_interfaces, *res.state_interfaces]
                    )
                )
            self.pending[key] = client.call_async(req)
        self.graph.setPlainText(
            "Nodes   "
            + ", ".join(ns.rstrip("/") + "/" + n for n, ns in nodes)
            + "\n"
            + "\n".join(self.snapshot.values())
            + "\n"
            + self.param_display
        )

    def profile_name(self):
        axis = self.axis.currentText().removesuffix("_motor")
        return "motor_profile" if axis == "bottom" else axis + "_profile"

    def poll_caps(self):
        name = self.profile_name()
        if name not in self.cap_clients:
            self.cap_clients[name] = self.node.create_client(
                GetParameters, "/" + name + "/get_parameters"
            )
        client = self.cap_clients[name]
        if self.cap_request:
            owner, started, future = self.cap_request
            if (
                owner == name
                and client.service_is_ready()
                and not future.done()
                and time.monotonic() - started < 2
            ):
                return
            self.cap_request = None
            self.caps.clear()
            if owner == name and future.done() and not future.cancelled():
                response = future.result()
                if response and len(response.values) == len(self.cap_names):
                    self.caps[name] = dict(
                        zip(self.cap_names, (v.double_value for v in response.values))
                    )
            else:
                future.cancel()
        if not client.service_is_ready():
            self.caps.clear()
        caps = self.caps.get(name)
        if caps:
            self.budget.setText(
                f"{caps['max_velocity_m_s']:.4g} m/s, {caps['max_duration_s']:.4g} s, "
                f"{caps['ramp_s']:.4g} s ramp, {caps['max_acceleration_m_s2']:.4g} m/s², "
                f"{caps['max_travel_m']:.4g} m"
            )
        else:
            self.budget.setText("Unavailable")
        if client.service_is_ready():
            request = GetParameters.Request(names=list(self.cap_names))
            self.cap_request = name, time.monotonic(), client.call_async(request)

    def poll_parameter(self):
        key = (self.param_node.text().strip(), self.param.text().strip())
        if not all(key):
            return
        if key != self.param_key:
            self.param_future = self.param_descriptor = None
            self.param_display = ""
            self.param_key = key
            if self.param_client:
                for client in self.param_client_clients:
                    self.node.destroy_client(client)
            before = list(self.node.clients)
            self.param_client = AsyncParameterClient(self.node, key[0])
            self.param_client_clients = [
                c for c in self.node.clients if c not in before
            ]
        if not self.param_client.services_are_ready():
            if self.param_future:
                for future in self.param_future:
                    future.cancel()
                self.param_future = None
            self.param_descriptor = None
            self.param_display = f"{key[0]}  {key[1]}  unavailable"
            return
        if self.param_future:
            if not all(f.done() for f in self.param_future):
                return
            values, desc = [f.result() for f in self.param_future]
            if values and desc and values.values and desc.descriptors:
                from rclpy.parameter import parameter_value_to_python

                self.param_descriptor = desc.descriptors[0]
                value = parameter_value_to_python(values.values[0])
                self.param_display = (
                    f"{key[0]}  {key[1]}  ({type(value).__name__})  {value}"
                )
                if self.param_descriptor.read_only:
                    self.param_display += "  read-only"
        self.param_future = (
            self.param_client.get_parameters([key[1]]),
            self.param_client.describe_parameters([key[1]]),
        )

    def dispose(self):
        # Destroy QObject children and their Python signal closures while the
        # application and interpreter are still alive.
        self.close()
        self.node.destroy_node()
        self.deleteLater()
        QtCore.QCoreApplication.sendPostedEvents(None, QtCore.QEvent.DeferredDelete)

    def closeEvent(self, event):
        self.timer.stop()
        self.refresh.stop()
        self.pulses.clear()
        if self.executor is not None:
            self.executor.remove_node(self.node)
            self.executor.shutdown()
            self.executor = None
        super().closeEvent(event)

    def run(self, argv, on_success=None):
        self.output.appendPlainText("$ " + shlex.join(argv))
        p = QtCore.QProcess(self)
        self.jobs.add(p)
        p.setProcessChannelMode(QtCore.QProcess.MergedChannels)
        chunks = []

        def read():
            chunk = bytes(p.readAllStandardOutput()).decode(errors="replace")
            if on_success:
                chunks.append(chunk)
            self.output.appendPlainText(chunk.rstrip())

        p.readyReadStandardOutput.connect(read)
        # Startup errors also produce a result when no child process was created.
        p.errorOccurred.connect(lambda _: self.output.appendPlainText(p.errorString()))

        def finish(code, *_):
            self.output.appendPlainText(f"Exit {code}")
            self.jobs.discard(p)
            p.deleteLater()
            if code == 0 and on_success:
                on_success("".join(chunks))

        p.finished.connect(finish)
        p.start(argv[0], argv[1:])

    def remote(self, argv, on_success=None):
        # Only argv data reaches the remote shell, quoted once at each boundary.
        domain = str(int(os.getenv("ROS_DOMAIN_ID", "0")))
        script = (
            'cd "$HOME/riser-control" && source /opt/ros/jazzy/setup.bash && source install/setup.bash && export ROS_DOMAIN_ID='
            + domain
            + " && exec "
            + shlex.join(argv)
        )
        self.run(
            [
                "ssh",
                "-o",
                "BatchMode=yes",
                "-o",
                "ConnectTimeout=5",
                "--",
                self.host,
                shlex.join(["bash", "-c", script]),
            ],
            on_success,
        )

    def jog(self, cancel):
        axis = self.axis.currentText()
        name = self.profile_name()
        client = self.clients.setdefault(name, None)
        if client is None:
            client = self.clients[name] = self.node.create_client(
                Jog, "/" + name + "/jog"
            )
        req = Jog.Request()
        req.cancel = cancel
        if not cancel:
            caps = self.caps.get(name)
            if not caps:
                raise ValueError("Waiting for the controller's jog bounds")
            req.velocity_m_s = float(self.speed.text())
            req.duration_s = float(self.duration.text())
            if (
                time.monotonic() - self.last > 0.3
                or self.samples[axis].get("ready") != 2
                or self.samples[axis].get("feedback_valid") != 1
                or (
                    req.velocity_m_s > 0
                    and self.samples[axis].get("forward_limit") != 0
                )
                or (
                    req.velocity_m_s < 0
                    and self.samples[axis].get("reverse_limit") != 0
                )
                or not math.isfinite(req.velocity_m_s)
                or abs(req.velocity_m_s)
                > min(caps["max_velocity_m_s"], float(self.hw["max_velocity_m_s"]))
                or abs(req.velocity_m_s) * req.duration_s
                > min(caps["max_travel_m"], float(self.hw["max_travel_m"]))
                or not 2 * caps["ramp_s"] <= req.duration_s <= caps["max_duration_s"]
                or abs(req.velocity_m_s)
                > caps["ramp_s"] * caps["max_acceleration_m_s2"]
            ):
                raise ValueError(
                    "Check readiness, speed, ramp, duration and travel budget"
                )
        if not client.service_is_ready():
            raise ValueError("Jog service unavailable")
        req.stamp = self.node.get_clock().now().to_msg()
        if name not in self.beats:
            self.beats[name] = self.node.create_publisher(
                Time, "/" + name + "/jog_heartbeat", 1
            )
        if cancel:
            self.pulses.pop(name, None)
        future = client.call_async(req)

        def response(f):
            result = f.result()
            self.output.appendPlainText(str(result))
            if result and result.accepted and not cancel:
                self.pulses[name] = (req.stamp, time.monotonic() + req.duration_s)

        future.add_done_callback(response)
        args = (
            ["--cancel"]
            if cancel
            else [
                "--velocity",
                str(req.velocity_m_s),
                "--duration",
                str(req.duration_s),
            ]
        )
        self.output.appendPlainText(
            shlex.join(
                [
                    "ros2",
                    "run",
                    "riser_motion_bringup",
                    "g5_jog",
                    "--axis",
                    axis.removesuffix("_motor"),
                    *args,
                ]
            )
        )

    def address(self):
        axis = self.axis.currentText()
        if getattr(self, "real", None) is False:
            raise ValueError("Physical drive actions are unavailable on a mock graph")
        hw = getattr(self, "hw", {})
        if not hw and axis == "bottom_motor":
            return ["0", "0", "0"]
        return [hw["master_index"], str(self.rings[axis]), hw[axis + "_serial"]]

    def clear_fault(self):
        self.remote(
            ["bash", "src/riser_hardware/scripts/reset_g5_fault.sh", *self.address()]
        )

    def shutdown_drive(self):
        self.address()
        self.remote(
            ["bash", "src/riser_hardware/scripts/shutdown_bottom_motor.sh"]
            + (
                ["--stop-profile"]
                if "motor_profile  active" in self.snapshot.get("controllers", "")
                else []
            )
        )

    def upload(self):
        index, sub = int(self.index.text(), 0), int(self.sub.text(), 0)
        self.remote(
            [
                "ros2",
                "run",
                "riser_motion_bringup",
                "g5_upload",
                *self.address(),
                hex(index),
                str(sub),
                self.dtype.currentText(),
            ]
        )

    def lifecycle(self, k):
        name = self.controller.text()
        args = {
            "load": ["load_controller", name],
            "configure": ["set_controller_state", name, "inactive"],
            "activate": ["set_controller_state", name, "active"],
            "deactivate": ["set_controller_state", name, "inactive"],
            "unload": ["unload_controller", name],
        }
        self.run(["ros2", "control", *args[k]])

    def parameter(self, k):
        node = self.param_node.text()
        if k == "set" and self.param_descriptor and self.param_descriptor.read_only:
            raise ValueError("Parameter is read-only")
        if k == "set" and node.strip("/") + "  active" in self.snapshot.get(
            "controllers", ""
        ):
            raise ValueError(
                "Deactivate the controller before changing its configuration"
            )
        self.run(
            ["ros2", "param", k, node]
            + ([] if k == "list" else [self.param.text()])
            + ([self.value.text()] if k == "set" else [])
        )

    def inactivate_mock(self):
        if getattr(self, "real", None) is not False:
            raise ValueError("Use ordered PREOP shutdown on the G5 bench")
        self.run(
            [
                "ros2",
                "control",
                "set_hardware_component_state",
                "BottomMotor",
                "inactive",
            ]
        )

    def maintenance(self, *args):
        self.remote(["ros2", "run", "riser_motion_bringup", "g5_rebuild", *args])

    def rebuild(self):
        self.maintenance("--package", self.package.text())

    def trial_action(self, k):
        args = (
            [self.desc.text(), *self.topics.text().split()]
            if k == "start"
            else [self.trial.text(), *self.topics.text().split()]
            if k == "export"
            else [self.trial.text()]
            if k == "verify"
            else []
        )

        def select(text):
            names = [line.strip() for line in text.splitlines() if line.strip()]
            if k == "start" and names:
                self.trial.setText(names[-1])
            elif k == "list" and names:
                value, ok = W.QInputDialog.getItem(
                    self, "Finalized trials", "Trial", names, editable=False
                )
                if ok:
                    self.trial.setText(value)

        self.remote(
            ["ros2", "run", "riser_motion_bringup", "g5_trial", k, *args],
            select if k in ("list", "start") else None,
        )

    def transfer(self):
        import re

        name = self.trial.text()
        if not re.fullmatch("[A-Za-z0-9_-]+", name):
            raise ValueError("Select a dated trial")
        self.output.appendPlainText(
            shlex.join(
                ["scp", "-r", "--", self.host + ":riser-control/data/" + name, "."]
            )
        )

    def open_bag(self):
        path, _ = W.QFileDialog.getOpenFileName(
            self, "Select transferred bag", "", "ROS bag (*.mcap *.db3 metadata.yaml)"
        )
        if path:
            from pathlib import Path

            self.run(
                [
                    "ros2",
                    "run",
                    "riser_motion_bringup",
                    "g5_plot_trial",
                    str(Path(path).parent),
                    *self.topics.text().split(),
                ]
            )


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--ssh-host", required=True)
    args = parser.parse_args()
    app = W.QApplication(sys.argv)
    rclpy.init()
    window = Console(args.ssh_host)
    window.show()
    app.exec()
    window.dispose()
    rclpy.shutdown()


if __name__ == "__main__":
    main()
