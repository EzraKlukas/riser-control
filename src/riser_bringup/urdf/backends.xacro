<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="public_control_joint" params="name lower upper velocity mode all_commands:=false resource_type:=joint command_enabled:=true">
    <!-- Dictionary lookup rejects unsupported commands, including direct effort. -->
    <xacro:property name="command_interfaces"
        value="${dict(position='position', velocity='velocity', angular_position='position', angular_velocity='velocity')}" />
    <xacro:element xacro:name="${resource_type}" name="${name}">
      <param name="lower">${lower}</param>
      <param name="upper">${upper}</param>
      <param name="velocity_limit">${velocity}</param>
      <xacro:if value="${command_enabled}">
        <xacro:if value="${all_commands}">
          <command_interface name="position" />
          <command_interface name="velocity" />
        </xacro:if>
        <xacro:unless value="${all_commands}">
          <command_interface name="${command_interfaces[mode]}">
            <param name="initial_value">0.0</param>
          </command_interface>
        </xacro:unless>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
      <xacro:if value="${resource_type == 'gpio'}">
        <command_interface name="calibration_midpoint" />
        <command_interface name="calibration_half_travel" />
        <state_interface name="ready" />
        <state_interface name="feedback_valid" />
      </xacro:if>
      <xacro:if value="${all_commands}">
        <state_interface name="reverse_limit" />
        <state_interface name="forward_limit" />
        <xacro:unless value="${resource_type == 'gpio'}">
          <state_interface name="valid" />
        </xacro:unless>
      </xacro:if>
    </xacro:element>
  </xacro:macro>

  <xacro:macro name="pitch_parameters" params="prefix">
    <param name="${prefix}_reduced_table">${' '.join(map(str,rd['axes'][prefix]['table_flat']))}</param>
    <param name="${prefix}_pitch_kp">${c['direct_pitch'][prefix]['kp_Nm_rad']}</param>
    <param name="${prefix}_pitch_kd">${c['direct_pitch'][prefix]['kd_Nm_s_rad']}</param>
    <param name="${prefix}_pitch_max_torque">${c['direct_pitch'][prefix]['max_torque_Nm']}</param>
  </xacro:macro>

  <xacro:macro name="force_plate_state" params="name side">
    <sensor name="${name}">
      <param name="gz_topic">/riser/force_plates/${side}/raw</param>
      <param name="sample_timeout">0.1</param>
      <state_interface name="force.x" />
      <state_interface name="force.y" />
      <state_interface name="force.z" />
      <state_interface name="torque.x" />
      <state_interface name="torque.y" />
      <state_interface name="torque.z" />
      <state_interface name="valid" />
    </sensor>
  </xacro:macro>

  <xacro:macro name="gazebo_motor" params="axis enabled command_mode">
    <xacro:if value="${axis in enabled}">
      <xacro:property name="actuator" value="${axis + '_actuator'}" />
      <xacro:public_control_joint name="${axis + '_motor'}" resource_type="gpio"
          lower="${axis_lower[actuator]}" upper="${axis_upper[actuator]}"
          velocity="${model_velocity[actuator]}" mode="${command_mode}" all_commands="true" />
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="riser_backend" params="backend controllers_file command_mode enabled_axes">
    <xacro:if value="${backend != 'none'}">
      <xacro:property name="enabled" value="${enabled_axes.split(',')}" />
      <ros2_control name="RiserSystem" type="system">
        <hardware>
          <plugin>${dict(mock='mock_components/GenericSystem', gazebo='riser_gazebo/AngularSystem')[backend]}</plugin>
          <param name="physical_state_rate">${c['physical_state_rate_hz']}</param>
          <param name="command_mode">${dict(position='position', velocity='velocity', angular_position='angular_position', angular_velocity='angular_velocity', actuator_position='actuator_position', actuator_velocity='actuator_velocity')[command_mode]}</param>
          <xacro:pitch_parameters prefix="top" />
          <xacro:pitch_parameters prefix="bottom" />
          <param name="torso_height">${c['ml']['height_m']['torso']}</param>
          <param name="hip_height">${c['ml']['height_m']['hip']}</param>
          <param name="servo_kp">${c['servo']['kp_N_m']}</param>
          <param name="servo_kd">${c['servo']['kd_N_s_m']}</param>
          <param name="servo_max_force">${c['servo']['max_force_N']}</param>
          <!-- Canonical axis order: pitch, torso, hip, foot. -->
          <xacro:property name="mapping_axes" value="${['frame_pitch', 'torso_lateral', 'hip_lateral', 'foot_pitch']}" />
          <param name="neutral_cad">${' '.join(str(k['neutral_cad'][axis]) for axis in mapping_axes)}</param>
          <xacro:if value="${backend == 'gazebo'}">
            <!-- Keep full transmission limits when a motor resource is hidden. -->
            <xacro:property name="motors" value="${['top_actuator', 'torso_actuator', 'hip_actuator', 'bottom_actuator']}" />
            <param name="motor_limits">${' '.join(' '.join(map(str, [axis_lower[m], axis_upper[m], model_velocity[m]])) for m in motors)}</param>
            <param name="enabled_axes">${enabled_axes}</param>
            <param name="configured_axes">top,torso,hip,bottom</param>
          </xacro:if>
        </hardware>
        <xacro:public_control_joint
            name="backboard_pitch"
            command_enabled="${backend != 'gazebo' or 'top' in enabled}"
            lower="${k['joints']['frame_pitch']['lower']}"
            upper="${k['joints']['frame_pitch']['upper']}"
            velocity="${model_velocity['frame_pitch']}"
            mode="${command_mode}" all_commands="${backend == 'gazebo'}" />
        <xacro:public_control_joint
            name="foot_plate_pitch"
            command_enabled="${backend != 'gazebo' or 'bottom' in enabled}"
            lower="${-axis_upper['foot_pitch'] if backend == 'gazebo' else axis_lower['foot_pitch']}"
            upper="${-axis_lower['foot_pitch'] if backend == 'gazebo' else axis_upper['foot_pitch']}"
            velocity="${model_velocity['foot_pitch']}"
            mode="${command_mode}" all_commands="${backend == 'gazebo'}" />
        <xacro:public_control_joint
            name="ml_angle"
            command_enabled="${backend != 'gazebo' or ('torso' in enabled and 'hip' in enabled)}"
            lower="${-c['ml']['limit_rad']}"
            upper="${c['ml']['limit_rad']}"
            velocity="${model_ml_velocity}"
            mode="${command_mode}" all_commands="${backend == 'gazebo'}" />
        <xacro:if value="${backend == 'gazebo'}">
          <xacro:force_plate_state name="left_force_plate" side="left" />
          <xacro:force_plate_state name="right_force_plate" side="right" />
        </xacro:if>
        <!-- Virtual actuator resources belong to the custom Gazebo adapter.
             The mock backend retains its three-coordinate contract. -->
        <xacro:if value="${backend == 'gazebo'}">
          <xacro:gazebo_motor axis="top" enabled="${enabled}" command_mode="${command_mode}" />
          <xacro:gazebo_motor axis="torso" enabled="${enabled}" command_mode="${command_mode}" />
          <xacro:gazebo_motor axis="hip" enabled="${enabled}" command_mode="${command_mode}" />
          <xacro:gazebo_motor axis="bottom" enabled="${enabled}" command_mode="${command_mode}" />
        </xacro:if>
      </ros2_control>
    </xacro:if>
    <xacro:if value="${backend == 'gazebo'}">
      <gazebo>
        <plugin
            filename="libriser_gazebo_system.so"
            name="riser_gazebo::PhysicsClockControlPlugin">
          <ros>
            <remapping>robot_description:=/robot_description</remapping>
          </ros>
          <parameters>${controllers_file}</parameters>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
