<?xml version="1.0"?>
<sdf version="1.8">
  <world name="riser_world">
    <physics name="validated_step" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.2</real_time_factor>
    </physics>
    <scene>
      <shadows>false</shadows>
    </scene>
    <gravity>0 0 -9.80665</gravity>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster">
      <dynamic_pose_hertz>30</dynamic_pose_hertz>
      <state_hertz>20</state_hertz>
    </plugin>
    <plugin filename="ignition-gazebo-forcetorque-system" name="ignition::gazebo::systems::ForceTorque"/>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>.8 .8 .8 1</diffuse>
      <specular>.2 .2 .2 1</specular>
      <direction>-.5 -.2 -1</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground">
        <collision name="ground">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="left_test_weight">
      <pose>0.1516 0.167 0.60361 0 0 0</pose>
      <link name="weight">
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.0012</ixx>
            <iyy>0.0012</iyy>
            <izz>0.0012</izz>
          </inertia>
        </inertial>
        <visual name="weight">
          <geometry>
            <box>
              <size>0.06 0.06 0.06</size>
            </box>
          </geometry>
        </visual>
        <collision name="weight">
          <geometry>
            <box>
              <size>0.06 0.06 0.06</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
